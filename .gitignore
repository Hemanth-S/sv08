# Klipper / Moonraker runtime files we don't want in git
*.log
*.bak
*.tmp
*~
.*.sw[a-z]

# Timestamped config snapshots (e.g. printer-20260506_192243.cfg), written
# when configs are saved/edited via the web UI. They capture an OLDER state --
# never copy one back over printer.cfg thinking it is current.
printer-*.cfg

# Moonraker / Klipper backup copies (e.g. .moonraker.conf.bkp)
*.bkp

# Python bytecode (in case any helper scripts land here)
__pycache__/
*.pyc

# Secrets / credentials (just in case Moonraker's secrets file ends up here)
moonraker.secrets
*.secret
