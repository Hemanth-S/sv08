# Klipper firmware build config: BTT Octopus Pro v1.1 (STM32H723)
# Minimal: `make olddefconfig` fills in every other option with Klipper's defaults.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_STM32_FLASH_START_20000=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_USB_PA11_PA12=y
