# Klipper / Moonraker runtime files we don't want in git
*.log
*.bak
*.tmp
*~
.*.sw[a-z]

# Timestamped config backups Klipper writes before each SAVE_CONFIG
# (e.g. printer-20260506_192243.cfg). These hold the PRE-save state --
# never copy one of these back as your live config.
printer-*.cfg

# Moonraker / Klipper backup copies (e.g. .moonraker.conf.bkp)
*.bkp

# Python bytecode (in case any helper scripts land here)
__pycache__/
*.pyc

# Secrets / credentials (just in case Moonraker's secrets file ends up here)
moonraker.secrets
*.secret
